# Application
NODE_ENV=production
PORT=10000

# সেশন সিকিউরিটি (Render অটো বানায়; নিজে দিলে কমপক্ষে ৩২ অক্ষর)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# অ্যাডমিন — Firebase Authentication-এ যে ইমেইলে ইউজার বানিয়েছেন (একাধিক হলে কমা দিয়ে)
ADMIN_EMAIL=MahimHossainBD@gmail.com

# Firebase সার্ভিস অ্যাকাউন্ট (Project settings → Service accounts → Generate new private key)
# JSON ফাইলের project_id, client_email, private_key — এগুলো কখনো GitHub-এ দেবেন না
FIREBASE_PROJECT_ID=mahimhossain-bd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mahimhossain-bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://mahimhossain-bd-default-rtdb.firebaseio.com

# GitHub (ছবি, ভিডিও, APK রাখার জন্য) — রিপো অবশ্যই Public
GITHUB_TOKEN=github_pat_xxxxxxxx
GITHUB_REPO=your-username/your-files-repo
GITHUB_RELEASE_TAG=apps
